<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RubeNotePad" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brown_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/header_yellow</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brown_fab</item>
        <item name="android:statusBarColor">@color/brown_dark</item>
        <item name="android:navigationBarColor">@color/brown_dark</item>
        <item name="android:windowBackground">@color/paper_yellow</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="toolbarStyle">@style/Widget.RubeNotePad.Toolbar</item>
    </style>

    <style name="Widget.RubeNotePad.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brown_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="TextAppearance.RubeNotePad.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
