<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Yellow paper base -->
    <item>
        <shape>
            <solid android:color="@color/paper_yellow" />
        </shape>
    </item>
    <!-- Tiled horizontal rule lines (paper_line.png is a 32dp-tall tile) -->
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/paper_line"
            android:tileModeX="repeat"
            android:tileModeY="repeat" />
    </item>
</layer-list>
